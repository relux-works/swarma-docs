@startuml
left to right direction
skinparam defaultFontName PT Sans
skinparam defaultFontSize 18
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #23466e
skinparam rectangleBackgroundColor #eef1f5
skinparam rectangleBorderColor #23466e
rectangle "Корень оператора\nаппаратный FIDO-ключ\nсообщений не подписывает" as root
rectangle "Ключ устройства\nSecure Enclave: P-256 low-S\nроли act, approver; срок" as device
rectangle "Matrix master\n↓ self-signing\n↓ device (E2EE)" as master
rectangle "OMEMO device\nкаждый fingerprint" as xmpp
rectangle "Корень аттестаций\nключника" as km
rectangle "Ключ агента\nswarma-msg: Ed25519\nсрок до 24 ч" as agent
rectangle "Корень реестра\nснимки отзывов агентов,\nконтрольные точки, свежесть" as registry
root --> device : аттестация
root --> master : аттестация
root --> xmpp : аттестация
km --> agent : аттестация
registry --> agent : отзыв
@enduml
