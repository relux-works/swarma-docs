@startuml
skinparam defaultFontName PT Sans
skinparam defaultFontSize 18
skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam ParticipantBackgroundColor #eef1f5
skinparam ParticipantBorderColor #23466e
skinparam ArrowColor #23466e
hide footbox
participant "Устройство" as device
actor "Оператор / корень" as root
participant Реестр as registry
participant Верификатор as verifier
device -> root : публичный ключ для проверки
root -> registry : аттестация: P-256, роли, срок
registry --> verifier : журнал, контрольная точка, свежесть
verifier -> verifier : проверка цепочки и гранта
== Устройство потеряно ==
root -> registry : новый полный снимок отзывов
registry --> verifier : снимок не старше 60 с
verifier -> verifier : отвергать ключ с момента from
@enduml
