@startuml resolution-order
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
title Учётные данные: выбранный порядок разрешения
start
:определить источник аутентификации;
if (источник принадлежит дому?) then (да)
  :разрешить машинный выбор хранилища;
  if (адаптер поддерживает хранилище?) then (да)
    :проверить допустимость изоляции;
    if (изоляция допустима?) then (да)
      :shared — ссылка на общий файл;\nisolated — собственный логин дома;
    else (нет)
      :отказ; например Claude на macOS в shared;
      stop
    endif
  else (нет)
    :отказ без скрытой подмены хранилища;
    stop
  endif
else (наследуемый)
  :без собственного логина дома;\nдоставка исполнителю ещё предложена;
endif
:метаданные и настройки запуска;\nбез миграции и удаления учётных данных;
stop
@enduml
