@startuml platform-storage-layout
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam packageStyle rectangle
title Swarm Runtime: выбранная раскладка хранения
package "Корень установки" {
  folder "libexec/\nПривилегированные программы" as BIN
  folder "etc/\nПолитика root" as ETC
  folder "lib/user-manager/\nПоколения и квитанции" as LEDGER
  folder "run/\nСокеты служб" as RUN
  folder "Сервисные дома\nСекреты и состояние служб" as SERVICES
  folder "workers/\nЗакрытый дом на агента" as WORKERS
  folder "quarantine/\nДом после вывода учётки" as QUAR
  folder "archive/\nТолько служебные метаданные" as ARCH
}
WORKERS --> QUAR : после подтверждённой остановки
QUAR --> ARCH : экспорт метаданных;\nдом удаляется
note bottom of ARCH
  Сохранения дома оператором в первой версии нет.
end note
@enduml
