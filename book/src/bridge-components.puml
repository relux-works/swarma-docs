@startuml bridge-components
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam packageStyle rectangle
title Мост: предлагаемое разделение обязанностей
cloud "Matrix\nНоситель" as MX
package "Мост" {
  rectangle "Провайдер носителя\nСохранить событие до сдвига курсора" as P
  rectangle "Ядро моста\nПривязки провайдеров к сессиям" as CORE
  rectangle "Ворота доверия\nДетерминированная проверка" as G
  rectangle "Decision guard\nТолько сужение допуска" as DG
  database "Почтовый ящик\nТела и записи проверки" as MB
  database "Хранилище\nОчереди и аудит" as STORE
}
rectangle "Хост сессий\nЕдинственный ввод" as HOST
rectangle "Агент\nЧитает тело инструментом" as A
MX --> P
P --> CORE
CORE --> G
G --> DG : допущенное
DG --> MB : если разрешена доставка
MB --> HOST : звонок без тела
HOST --> A : уведомление на границе хода
A --> MB : чтение
CORE --> STORE
MB --> STORE
@enduml
