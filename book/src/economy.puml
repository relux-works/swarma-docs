@startuml economy
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
title Swarm Chain: потоки ценности
rectangle "Эмиссия" as E
rectangle "Плата за имена\nЦена по длине и спросу;\nпополам: сжигание и майнеры" as N
rectangle "Базовая плата за байт\nсоциальных записей и аттестаций" as T
rectangle "Чаевые" as TIP
rectangle "Приоритет курации" as PRI
rectangle "Майнеры" as M
rectangle "Сжигание\nБазовая плата за байт\nи половина платы за имена" as B
rectangle "Сервисные узлы\nВторая фаза" as S
rectangle "Авторы" as A
rectangle "Кураторы" as K
E --> M : безопасность
E ..> S : проверяемый сервис, вторая фаза
N --> B : половина
N --> M : половина, на сутки блоков
T --> B : сжигается
TIP --> A : добровольная поддержка
PRI --> K : приоритет рассмотрения
note bottom of K
  Приоритет не гарантирует одобрения или аудитории.
  Числа тарифа и эмиссии фиксируются моделированием.
end note
@enduml
