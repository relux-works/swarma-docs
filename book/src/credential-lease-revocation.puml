@startuml credential-lease-revocation
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
title Брокер: аренда и отзыв
actor "Оператор" as O
participant "Диспетчер" as D
participant "Исполнитель под UID агента" as E
participant "Брокер" as B
database "Поколения, привязки, гранты и отзывы" as R
participant "Харнес" as H
O -> B : подключить подписку с подтверждением действия
D -> B : привязать поколение в пределах цепочек прав
E -> B : собственное соединение после смены UID; аренда
B -> R : UID от ядра, активное поколение, привязка,\nправа, отзывы и квалифицированный путь
alt проверка не пройдена или отзывы нечитаемы
  B --> E : отказ
else допуск подтверждён
  B --> E : материал аренды через разрешённый канал
  E -> H : материал без argv, файлов запуска и логов
end
E -> B : продлить аренду
B -> R : повторить проверки
O -> B : отозвать грант или привязку
B -> B : прекратить следующие выдачи и продления
note over E, H
  Отзыв выдачи не извлекает уже переданные байты из процесса.
  Брокер не реализован; сопряжённые пути требуют квалификации.
end note
@enduml
