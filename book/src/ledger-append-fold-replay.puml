@startuml ledger-append-fold-replay
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
title Swarm Keeper: предлагаемые запись и восстановление
start
:получить событие или внутренний триггер;
if (событие уже записано?) then (да)
  :не менять состояние;
  stop
endif
if (переход допустим?) then (да)
  :присвоить последовательный номер и метаданные;
  :атомарно дописать запись;
  :свернуть записи по последовательным номерам;
else (нет)
  :отклонить без расходования номера;
endif
stop
start
:восстановление после старта или сжатия контекста;
:отбросить оборванную последнюю запись;
:свернуть весь журнал;
:дописать недостающие последствия\nсо ссылкой на прежнюю причину;
:дослать уведомления без квитанции\nс теми же номерами;
:начать новую работу;
stop
@enduml
