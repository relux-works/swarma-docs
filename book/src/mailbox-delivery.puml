@startuml mailbox-delivery
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
title Предлагаемая доставка почты
participant "Провайдер носителя" as P
participant "Ворота доверия" as G
participant "Decision guard" as DG
database "Почтовый ящик" as M
participant "Хост сессий" as H
participant "Агент" as A
P -> P : сохранить событие на диск; затем сдвинуть курсор
P -> G : точные байты конверта
G -> G : подпись, класс ключа, грант,\nсвежесть, повторы и привязка
alt нет подписи
  G -> M : удержать тело в карантине
  G -> H : звонок только с метаданными
else подпись неверна или иная проверка провалена
  G -> M : квитанция отказа и аудит; доставки нет
else допущено
  G -> DG : тело и запись проверки
  alt guard недоступен или отказал
    DG -> M : отказ в доставке
  else guard разрешил
    DG -> M : тело и вердикт
    M -> H : звонок без тела
  end
end
opt звонок поставлен в очередь
  H -> H : долговечная очередь; повторный допуск\nперед доставкой, открытый забор
  H -> A : звонок на границе хода
  A -> M : забрать тело инструментом
end
note over H, A
  Почта от другого агента — данные, не полномочие на эффект.
  Типизированное действие оператора требует отдельного допуска.
end note
@enduml
