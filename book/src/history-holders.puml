@startuml history-holders
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam rectangleRoundCorner 10
skinparam packageStyle rectangle
skinparam linetype polyline
skinparam ranksep 45
title Кто держит историю и как читает лёгкий клиент

rectangle "Полные узлы\nзаголовки, тела, снимки;\nсегменты — только свежие" as N

package "Хранители истории" {
  rectangle "Индексаторы\nвся история и вычисленный индекс\n(индекс — платный продукт)" as I
  rectangle "Архивисты\nстарые сегменты как торренты\nпо политике своей окрестности" as L
  rectangle "Сервисные узлы (вторая фаза)\nоплата за проверку\nхранения случайного сегмента" as S
}

actor "Лёгкий клиент" as C

C --> N : заголовки от checkpoint\nи фильтры
C --> L : совпавшие сегменты\n+ доказательство Меркла
C --> I : поиск, «что обсуждают»,\nпервая загрузка
C ..> I : сверка хэшей состояния\nнескольких индексаторов
N --> I : новые блоки
N --> L : новые блоки
N --> S : новые блоки
@enduml
