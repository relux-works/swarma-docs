@startuml sublayers
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam packageStyle rectangle
title Swarm Chain: предлагаемое устройство подслоёв
actor "Автор" as A
actor "Читатель" as V
package "Цепочка" {
  rectangle "Деньги и имена\nКонсенсус" as CONS
  rectangle "Социальные записи и указатели\nФорма, подпись, оплата" as SOC
}
package "Социальный граф" {
  rectangle "Индексаторы\nГраф, ленты, поиск и веса" as I
  rectangle "Кураторы и архивисты\nВыбор и хранение" as K
}
package "P2P-память" {
  rectangle "Трекеры и рои раздачи\nТяжёлый контент вне цепочки" as P
}
A --> SOC : подписанный указатель
A --> P : раздача файла
SOC --> I : порядок записей
I --> V : лента
I --> K : поток и окрестность
K --> SOC : категоризации
K --> P : раздача выбранного
V --> P : скачать и раздавать
note bottom of P
  Принятый указатель не гарантирует сохранности файла.
end note
@enduml
