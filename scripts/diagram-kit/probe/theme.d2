# Swarma diagram theme probe for D2
vars: {
  d2-config: {
    pad: 40
    theme-overrides: {
      N1: "#1f2328"
      N2: "#57606a"
      N7: "#ffffff"
    }
  }
}
classes: {
  human: {style: {fill: "#f1f2f4"; stroke: "#8a919c"; stroke-width: 2; border-radius: 10; font-size: 20; bold: true}}
  key: {style: {fill: "#fff8e1"; stroke: "#a8740a"; stroke-width: 2; border-radius: 10; font-size: 20}}
  service: {style: {fill: "#eaf1ff"; stroke: "#2f6fdb"; stroke-width: 2; border-radius: 10; font-size: 20}}
  external: {style: {fill: "#fff1e6"; stroke: "#d9730d"; stroke-width: 2; border-radius: 10; font-size: 20}}
  boundary: {style: {fill: transparent; stroke: "#a8740a"; stroke-dash: 4; stroke-width: 2; border-radius: 14; font-color: "#a8740a"; text-transform: uppercase; font-size: 16}; label.near: top-left}
  step: {style: {stroke: "#3a3f47"; stroke-width: 2; font-size: 17; bold: true}}
}
