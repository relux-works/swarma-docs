@startuml bcd-boundary
' Рисунок книги кипера, глава 11. Граница пакетов B, C и D.
' Источник: решение R243 (12.10): B в curator-keeper, C — только адаптеры
' свидетельств, D — если подтвердится пробел правила 32.
' Источник: подтверждение пробела оркестратором a2a (a2a cc1d79e,
' BUG-261012-2e1g7z) и граница B/C/D, согласованная сторонами 12.10.
' Источник: curator-keeper spec/keeper.md §10.8 (PR #9 r1): «Три пакета,
' один журнал»; протокол a2a, правило 32; документация a2a docs/cli.md.
' Статус: размещение — решено (R243); граница — согласовано; что добавляет D —
' в работе; живость и почтовый ящик a2a — работают сегодня; шов таймеров
' и открытых вопросов — направление второй редакции, не договорено.
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam rectangleRoundCorner 8
skinparam packageStyle rectangle
left to right direction
title Граница B, C и D: один журнал, транспорт и свидетельства

actor "Человек-\nвладелец" as OW

package "D: a2a — только транспорт\n(состояния обязательств нет)" as DPKG {
  rectangle "пометки правила 32\nв полях сообщения\nс проверкой\n(добавляет D)" as MARKS
  rectangle "reply-by\nполный UTC\n(есть; D несёт его\nот конца до конца)" as RB
  rectangle "questions:\nвопросы без ответа\nиз истории сообщений\n(добавляет D)" as Q
  rectangle "живость: #status, who;\nпочтовый ящик и звонок\n(работают сегодня)" as LIVE
}

package "B: ядро кипера (curator-keeper)\nединственный журнал" as BPKG {
  rectangle "журнал обязательств:\nзапись, свёртка,\nвосстановление" as LED
  rectangle "сроки и сверка:\nполовина срока, срок,\nчасы (F-21)" as DL
  rectangle "эскалация:\nэпизоды, ступени 0–3,\nожидание человека" as ESC
  rectangle "наблюдение:\nздоров / ухудшился /\nпотерян" as OBS
}

package "C: доска — только свидетельства\n(журнала и сроков нет)" as CPKG {
  rectangle "события ранов" as RUN
  rectangle "первое действие\nи готовность" as FA
}

MARKS --> LED : вопрос с пометкой —\nобязательство открыто
RB --> DL : срок
Q --> LED : без ответа / ответ в треде —\nвход, не решение
LIVE --> OBS : входы наблюдения
RUN --> LED : ссылка: вид и id
FA --> LED : свидетельство\nпервого действия
ESC --> MARKS : шаг: адресный вопрос,\nreply-by = сроку шага
ESC --> OW : owner-needed\n(пока P03 открыт)
OW --> ESC : решает на ступени 3

note bottom of BPKG
  В первом срезе C и D — заглушки с тем же интерфейсом.
  Формат провода D замораживается только после сверки
  владельцем спецификации ядра со схемой журнала.
end note
@enduml
