@startuml observer-ladder
' Рисунок книги кипера, глава 10. Кто за кем наблюдает: входы наблюдения,
' журнал кипера и следующая ступень.
' Источник: curator-keeper spec/keeper.md §10.8 (PR #9 r1): «Здоровье
' наблюдателя» — входы #status, questions пакета D, свидетельства пакета C;
' живость остаётся в a2a.
' Источник: заметка 2 мета-кипера Алексея (Matrix, 12.10): живость самого
' кипера — вход наблюдения следующей ступени.
' Источник: ревью r1 (sol 5): курсоры, сроки наблюдения, ссылки на оценки.
' Источник: документация a2a docs/cli.md на 12.10: #status, who, возраст
' без ответа, тревоги.
' Статус: входы и три состояния — предложено (r1); курсоры, сроки
' и ступени свидетельства — вторая редакция; живость кипера как вход
' следующей ступени — согласовано; возможности a2a — работают сегодня.
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam rectangleBorderColor #444444
skinparam componentStyle rectangle
top to bottom direction
title Кто за кем наблюдает

rectangle "Входы наблюдения" as IN {
  rectangle "a2a: #status и who\nживость, устаревание,\nможно ли разбудить,\nвозраст без ответа" as A2A
  rectangle "пакет D: questions\nоткрытые вопросы\nи их reply-by" as D
  rectangle "пакет C: доска\nсобытия ранов,\nпервое действие,\nготовность" as C
  rectangle "сторож кипера\nлимиты провайдеров,\nсжатие контекста" as W
}

rectangle "Журнал кипера продукта" as K {
  rectangle "observer.health:\nздоров / ухудшился / потерян" as H
  rectangle "курсоры входов,\nсроки наблюдения,\nссылки на оценки" as CUR
}

rectangle "Ступени наблюдения" as LADDER {
  rectangle "оркестраторы продукта" as O
  rectangle "кипер продукта" as KP
  rectangle "мета-кипер" as MK
  rectangle "человек-владелец" as HU
}

A2A --> H
D --> H
C --> H
W --> H
H --> CUR
H ..> LADDER : «потерян» —\nэскалация по цепочке\n(глава 6)
KP --> O : наблюдает
MK --> KP : наблюдает:\nживость кипера —\nвход следующей ступени
HU --> MK : видит: вопросы к владельцу,\nтревоги a2a

legend bottom
  Живость остаётся в a2a: журнал её не повторяет, а записывает выводы со ссылками.
  Засчитывается только подтверждённая ступень свидетельства: сохранено, доставлено, прочитано, сделано.
endlegend
@enduml
