@startuml keeper-platform
' Рисунок книги кипера, глава 12. Кипер и его ядро в платформе Swarma.
' Источник: книга Swarma, главы 2, 3, 6, 7, 9, 13 и послесловие (модули,
' учётки, доставка в ввод сессии, host_start/host_stop, team/1).
' Источник: решения владельцев 7–12.10: пользователь ОС на агента, два канала
' в сессию, D-GOALS, F-4, F-20, F-23, постоянная команда.
' Источник: curator-keeper spec/keeper.md §10.8 (PR #9 r1) и направление второй
' редакции: один писатель — пользователь ОС кипера; кипер ничего не запускает сам.
' Статус: модули платформы — спецификация, мост и ключник — архитектура;
' место ядра — направление второй редакции.
!theme plain
skinparam defaultFontName "PT Sans"
skinparam shadowing false
skinparam rectangleRoundCorner 8
skinparam packageStyle rectangle
title Кипер в платформе Swarma

actor "Владелец" as OW

package "Учётка swarma-operator" as OPACC {
  rectangle "операторские команды:\nгранты, team/1\n(подпись с телефона\nили пароль в терминале)" as OP
}

package "Учётка кипера (worker-<метка>)" as KACC {
  rectangle "сессия кипера:\nроль (модель решает)" as KH
  rectangle "модуль keeper:\nсверка, ядро\n(команда делает)" as KM
  database "журнал обязательств\nпишет только\nэтот пользователь ОС" as JF
}

rectangle "диспетчер\nфизически запускает\nтолько он" as D
rectangle "менеджер пользователей\nи запускатель\n(root через sudo):\nучётки, запуск, exec.stop" as UM
rectangle "хост сессий\nлогические сессии,\nзаборы, ввод" as SH
rectangle "брокер учётных\nданных\nгранты, аренды" as CB
rectangle "мост и почтовый ящик\nпровайдер Matrix,\nпроверка, звонок\n(архитектура)" as BR #F4F4F4;line.dashed
rectangle "доска\nнеобязательный клиент;\nпакет C: свидетельства" as TB
rectangle "сессии корневых\nоркестраторов\n(свои учётки)" as ORCH

OW --> OP : подписывает
OP --> D : team/1
OP --> CB : гранты
KH <--> KM
KM --> JF : дописывает
KM --> SH : «возобнови сессию\nкорневого оркестратора»\n(по гранту)
SH --> D : host_start / host_stop
D --> UM : запуск и остановка\nисполнений
UM --> ORCH : исполнение\nпод учёткой
CB --> ORCH : аренда\nучётных данных
BR --> SH : проверенное\nсообщение
SH --> KH : звонок в ввод\nна границе хода
SH --> ORCH : звонок в ввод\nна границе хода
KM <--> BR : шаги эскалации,\nвопросы и ответы a2a
TB --> KM : свидетельства

note bottom of JF
  Ссылки, а не копии: исполнения — диспетчер и хост,
  раны — доска, сообщения — a2a и мост.
  Сроки обязательств не ограничивают
  постоянную команду.
end note
@enduml
